# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=games_deals
MYSQL_USER=games_crawler
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me

# Crawler
LOG_LEVEL=INFO
CRAWL_INTERVAL_MINUTES=60
REQUEST_TIMEOUT_SECONDS=20
REQUEST_DELAY_SECONDS=2
MAX_ITEMS_PER_SOURCE=100
USER_AGENT=GamesDealsAggregator/1.0 (+contact: admin@example.com)

# Região de referência: Brasil. Não converte moedas estrangeiras automaticamente.
DEFAULT_REGION=BR
DEFAULT_CURRENCY=BRL

# Steam: endpoint público appdetails consulta IDs conhecidos, não busca catálogo inteiro.
STEAM_ENABLED=true
STEAM_APP_IDS=730,570
STEAM_COUNTRY=BR
STEAM_CURRENCY=brl

STEAM_PAGE_SIZE=25
STEAM_REQUEST_DELAY=2.5
STEAM_RATE_LIMIT_BACKOFF=15
REQUEST_RETRIES=3

REQUEST_DELAY=5
REQUEST_RETRIES=2
REQUEST_TIMEOUT=30

# Gameplayscassi: feed RSS WordPress configurável
GAMEPLAYSCASSI_ENABLED=true
GAMEPLAYSCASSI_FEED_URL=https://gameplayscassi.com.br/category/promocoes/feed/

# Integrações de parceiros: desabilitadas até obter endpoint/credenciais autorizados.
KINGUIN_ENABLED=false
KINGUIN_API_URL=
KINGUIN_API_TOKEN=
KINGUIN_ITEMS_PATH=products

GREENMANGAMING_ENABLED=false
GREENMANGAMING_API_URL=
GREENMANGAMING_API_TOKEN=
GREENMANGAMING_ITEMS_PATH=products

INSTANTGAMING_ENABLED=false
INSTANTGAMING_API_URL=
INSTANTGAMING_API_TOKEN=
INSTANTGAMING_ITEMS_PATH=products

# Mapeamento opcional dos campos JSON (ajuste conforme documentação de cada parceiro)
# Exemplo: KINGUIN_PRICE_FIELD=pricing.sale.amount
KINGUIN_ID_FIELD=id
KINGUIN_TITLE_FIELD=title
KINGUIN_URL_FIELD=url
KINGUIN_PRICE_FIELD=price
KINGUIN_ORIGINAL_PRICE_FIELD=original_price
KINGUIN_CURRENCY_FIELD=currency
KINGUIN_IMAGE_FIELD=image_url
KINGUIN_REGION_FIELD=region
KINGUIN_PLATFORM_FIELD=platform
